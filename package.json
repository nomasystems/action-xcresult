{
  "name": "action-xcresult",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub Action that generates annotations from an xcresult bundle",
  "main": "lib/main.js",
  "scripts": {
    "generate-xcresult-to-json-output": "./scripts/generate-xcresult-to-json-output.sh",
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src/**/*.ts",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "jest --silent",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actions/typescript-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Nomasystems S.L.",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "1.1.1",
    "@actions/tool-cache": "2.0.1",
    "npm-check-updates": "^17.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "eslint-plugin-github": "^5.1.2",
    "eslint-plugin-jest": "^28.8.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "json-schema-to-typescript": "15.0.2",
    "prettier": "3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
